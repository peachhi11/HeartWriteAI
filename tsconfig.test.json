{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "incremental": false,
    "lib": [
      "es2022"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/character-card/**/*.ts",
    "lib/persona/**/*.ts",
    "tests/character-card/**/*.ts",
    "tests/persona/**/*.ts",
    "types/character-card/**/*.ts",
    "types/persona/**/*.ts",
    "types/vendor/**/*.d.ts"
  ]
}
